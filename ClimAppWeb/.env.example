# Copiar a .env (no se sube a git) y completar.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (IPv4).
# Formato: postgresql://postgres.<ref>:<CONTRASEÑA>@aws-0-<región>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Upstash Redis (console.upstash.com → base de datos → pestaña "REST API").
# El ETL escribe: usa la URL y el token completo (no el de solo lectura).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
